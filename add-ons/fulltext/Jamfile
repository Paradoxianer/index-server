SubDir HAIKU_TOP src add-ons index_server fulltext ;

UsePrivateHeaders index_server shared ;

local sources =
	CLuceneDataBase.cpp
	FullTextAnalyser.cpp
	TranslatorTimeout.cpp

	IndexServerAddOn.cpp
	;

UseBuildFeatureHeaders clucene ;
Includes [ FGristFiles $(sources) ] : [ BuildFeatureAttribute clucene : headers ] ;
		# Dependency needed to trigger downloading/unzipping the package before
		# compiling the files.

Addon FullTextAnalyser :
	$(sources)
	:
	be translation [ BuildFeatureAttribute clucene : libraries ] [ TargetLibstdc++ ]
;

SEARCH on [ FGristFiles IndexServerAddOn.cpp ]
	+= [ FDirName $(SUBDIR) $(DOTDOT) ] ;
