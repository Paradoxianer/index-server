SubDir HAIKU_TOP src add-ons index_server exif ;

UsePrivateHeaders index_server shared ;
SubDirHdrs [ FDirName $(HAIKU_TOP) src add-ons index_server shared ] ;

local sources =
	ExifAnalyser.cpp
	RunWithTimeout.cpp

	IndexServerAddOn.cpp
	;

UseBuildFeatureHeaders exif ;
Includes [ FGristFiles $(sources) ] : [ BuildFeatureAttribute exif : headers ] ;
		# Dependency needed to trigger downloading/unzipping the package before
		# compiling the files.

Addon ExifAnalyser :
	$(sources)
	:
	be [ BuildFeatureAttribute exif : library ] [ TargetLibstdc++ ]
	;

SEARCH on [ FGristFiles IndexServerAddOn.cpp ]
	+= [ FDirName $(SUBDIR) $(DOTDOT) ] ;

SEARCH on [ FGristFiles RunWithTimeout.cpp ]
	+= [ FDirName $(SUBDIR) $(DOTDOT) shared ] ;
